# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Safe to expose to the browser.
# (Older projects: put the "anon" key here instead.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or legacy "service_role" key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → Session pooler connection string (with your DB password).
# Used only by `npm run db:push` / `npm run db:types:remote`.
SUPABASE_DB_URL=

# Passwords for the demo accounts created by `npm run db:seed` (8+ characters).
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# Optional: allow the admin "Reset demo data" button in production (FBLA demo project).
DEMO_MODE=
# Optional: the public URL encoded into QR labels (defaults to the current host).
NEXT_PUBLIC_SITE_URL=
